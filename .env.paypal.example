# ==============================================
# PAYPAL CONFIGURATION
# ==============================================
# Để sử dụng PayPal, bạn cần:
# 1. Tạo tài khoản PayPal Developer: https://developer.paypal.com
# 2. Tạo App trong Dashboard để lấy Client ID và Secret
# 3. Điền thông tin vào các biến dưới đây

# PayPal Client ID (từ PayPal Developer Dashboard)
PAYPAL_CLIENT_ID=your-paypal-client-id

# PayPal Client Secret (từ PayPal Developer Dashboard)
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# PayPal Mode: 'sandbox' cho test, 'live' cho production
PAYPAL_MODE=sandbox

# PayPal Currency (USD khuyến nghị cho giao dịch quốc tế)
PAYPAL_CURRENCY=USD

# Tỷ giá VND/USD (cập nhật định kỳ hoặc sử dụng API tỷ giá)
# Ví dụ: 1 USD = 24,000 VND
PAYPAL_EXCHANGE_RATE=24000

# PayPal Return URL (callback sau khi thanh toán thành công)
PAYPAL_RETURN_URL="${APP_URL}/payments/paypal/callback"

# PayPal Cancel URL (khi người dùng hủy thanh toán)
PAYPAL_CANCEL_URL="${APP_URL}/payments/paypal/cancel"

# PayPal Webhook ID (tùy chọn - cho webhook verification)
PAYPAL_WEBHOOK_ID=

# ==============================================
# HƯỚNG DẪN CẤU HÌNH PAYPAL
# ==============================================
#
# ** BƯỚC 1: Tạo PayPal Developer Account **
# - Truy cập: https://developer.paypal.com
# - Đăng ký hoặc đăng nhập với tài khoản PayPal của bạn
#
# ** BƯỚC 2: Tạo App trong Dashboard **
# - Vào "My Apps & Credentials"
# - Nhấn "Create App"
# - Chọn "Merchant" làm app type
# - Lưu lại Client ID và Secret
#
# ** BƯỚC 3: Cấu hình Sandbox (Môi trường Test) **
# - PayPal cung cấp sẵn tài khoản test
# - Vào "Sandbox" -> "Accounts" để lấy tài khoản test
# - Sử dụng tài khoản này để test thanh toán
#
# ** BƯỚC 4: Test với Sandbox **
# - PAYPAL_MODE=sandbox
# - Sử dụng Client ID và Secret từ tab "Sandbox"
# - Test với tài khoản sandbox (không mất tiền thật)
#
# ** BƯỚC 5: Chuyển sang Production **
# - PAYPAL_MODE=live
# - Sử dụng Client ID và Secret từ tab "Live"
# - Cần xác thực tài khoản PayPal Business
#
# ==============================================
# TÀI KHOẢN TEST PAYPAL SANDBOX
# ==============================================
# PayPal cung cấp tài khoản test mẫu:
#
# Buyer Account (Người mua):
# Email: sb-buyer@personal.example.com
# Password: [xem trong Sandbox Accounts]
#
# Merchant Account (Người bán):
# Email: sb-merchant@business.example.com  
# Password: [xem trong Sandbox Accounts]
#
# ** LƯU Ý: **
# - Thay thế bằng tài khoản test của bạn từ Dashboard
# - Không sử dụng email và mật khẩu thật trong sandbox
#
# ==============================================
# BẢO MẬT & BEST PRACTICES
# ==============================================
# ✅ KHÔNG commit .env file lên Git
# ✅ Sử dụng HTTPS trong production
# ✅ Validate webhook signature khi nhận webhook
# ✅ Log tất cả giao dịch để audit
# ✅ Sử dụng try-catch để xử lý lỗi
# ✅ Kiểm tra trạng thái order trước khi capture
# ✅ Cập nhật tỷ giá thường xuyên hoặc dùng API
# ✅ Test kỹ trên sandbox trước khi lên production
#
# ==============================================
# WEBHOOK (Tùy chọn - Cho thông báo real-time)
# ==============================================
# - Vào App Settings -> Add Webhook
# - Webhook URL: https://yourdomain.com/webhooks/paypal
# - Events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED
# - Lưu Webhook ID vào PAYPAL_WEBHOOK_ID
#
# ==============================================
